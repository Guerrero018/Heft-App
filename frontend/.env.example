# Copia este archivo como `.env` y ajusta la URL según tu entorno.
#
# Emulador Android → backend local en el PC:
# API_BASE_URL=http://10.0.2.2:8000/api/
#
# iOS simulator / web local:
# API_BASE_URL=http://127.0.0.1:8000/api/
#
# Producción (Render) — requiere desplegar el backend con body-measures:
API_BASE_URL=https://heft-backend-ywi0.onrender.com/api/
