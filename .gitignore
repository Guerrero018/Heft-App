# Root ignore
.DS_Store
*.log

# Frontend (Flutter)
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.metadata
frontend/.packages
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/android/app/debug/
frontend/android/app/profile/
frontend/android/app/release/

# Backend (Django/Python)
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
backend/.Python
backend/env/
backend/venv/
backend/pip-log.txt
backend/pip-delete-this-directory.txt
backend/db.sqlite3
backend/media/
backend/staticfiles/
backend/.env

# Artifacts
.gemini/
.agents/
/tmp/
credentials.txt
